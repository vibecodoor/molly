{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.claude"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "css": { "formatter": { "enabled": false } },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "useExhaustiveDependencies": "off" },
      "a11y": { "useSemanticElements": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noArrayIndexKey": "off" }
    }
  }
}
